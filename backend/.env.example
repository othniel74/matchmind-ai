# MatchMind backend configuration. Copy to backend/.env and fill in locally.
# backend/.env is ignored by git and excluded from Docker images. Never commit real values.
# Variables already set in your shell take precedence over this file.

# Which model provider the agent workflow uses: azure_openai, foundry, or blank for automatic
# (Azure OpenAI when its endpoint and deployment are set, otherwise the Foundry project).
MATCHMIND_AI_PROVIDER=

# --- Option A: Azure OpenAI resource ---------------------------------------------------
# Endpoint looks like https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# The deployment name you chose in Azure (not the base model name).
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Leave blank to sign in with Microsoft Entra ID (az login / managed identity) instead of a key.
AZURE_OPENAI_API_KEY=

# --- Option B: Microsoft Foundry project (Entra ID sign-in only; run az login) -----------
# Endpoint looks like https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# --- Tracing (see docs/AGENT_WORKFLOW.md) -------------------------------------------------
# off, console, otlp or azure_monitor. Prompts and generated text are never exported unless
# MATCHMIND_TRACE_SENSITIVE=true.
MATCHMIND_TRACING=off
OTEL_EXPORTER_OTLP_ENDPOINT=
APPLICATIONINSIGHTS_CONNECTION_STRING=
MATCHMIND_TRACE_SENSITIVE=false

# --- Local workflow switches (see docs/LOCAL_EVIDENCE_FOUNDATION.md) ---------------------
MATCHMIND_CORRECTIONS_ENABLED=false
MATCHMIND_REVIEW_ENABLED=false
MATCHMIND_PUBLICATION_ENABLED=false
